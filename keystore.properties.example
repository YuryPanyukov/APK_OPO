# Пример файла с секретами для подписи release-сборки.
# Скопируйте его в keystore.properties и заполните своими значениями.
# Файл keystore.properties не попадает в git (см. .gitignore).
#
# Путь storeFile указывается относительно корня проекта.
storeFile=release.jks
storePassword=changeit
keyAlias=apkopo
keyPassword=changeit
